{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/read_obsidian.py *)",
      "Bash(bash .claude/scripts/check-claude-usage.sh)",
      "Bash(.claude/scripts/handoff_respawn.sh *)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-start-location.sh\""
          }
        ]
      }
    ]
  }
}
